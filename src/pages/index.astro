---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const noutati = (await getCollection('noutati')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Construcții, energie verde, radon și consultanță | GMC Proiect Construct" description="GMC Proiect Construct: proiectare și construcții, sisteme de energie verde, măsurare și remediere radon, consultanță pentru finanțări. Soluții integrate pentru clădiri eficiente și sănătoase, în toată România." current="/">

  <section class="hero">
    <div class="wrap">
      <div class="hero-text">
        <h1>Soluții integrate pentru construcții, energie și mediu</h1>
        <p class="lead">Proiectăm și construim clădiri eficiente și sănătoase, livrăm sisteme de energie regenerabilă, măsurăm și remediem radonul și vă ajutăm să obțineți finanțarea pentru proiect. Un singur partener, de la idee la recepție.</p>
        <div class="cta-row">
          <a class="btn primary" href="/contact/">Solicită o ofertă</a>
          <a class="btn outline" href="#servicii">Descoperă serviciile</a>
        </div>
      </div>
      <img class="hero-img" src="/images/echipa.jpg" alt="Echipa GMC pe șantier, cu planul clădirii" width="1536" height="1024">
    </div>
  </section>

  <section class="section" id="servicii">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <h2>Ce facem</h2>
          <p class="intro">Construim și reabilităm clădiri, le dotăm cu soluții de energie verde, verificăm nivelul de radon și vă ajutăm să vă finanțați proiectele. Alegeți domeniul care vă interesează.</p>
        </div>
      </div>
      <div class="tiles four reveal">
        <a class="tile" href="/constructii/">
          <img src="/images/constructie.jpg" alt="" width="1536" height="1024" loading="lazy">
          <div class="body">
            <span class="num">01</span>
            <h3>Construcții și proiectare</h3>
            <p>Proiectăm, construim și reabilităm clădiri, cu eficiența energetică gândită din start.</p>
            <span class="link">Vezi serviciile</span>
          </div>
        </a>
        <a class="tile" href="/energie/">
          <img src="/images/fotovoltaice.jpg" alt="" width="1536" height="1024" loading="lazy">
          <div class="body">
            <span class="num">02</span>
            <h3>Energie verde</h3>
            <p>Livrăm sisteme fotovoltaice, soluții de stocare și pompe de căldură, de la proiect până la punerea în funcțiune.</p>
            <span class="link">Vezi soluțiile</span>
          </div>
        </a>
        <a class="tile" href="/radon/">
          <img src="/images/detector.jpg" alt="" width="1200" height="800" loading="lazy">
          <div class="body">
            <span class="num">03</span>
            <h3>Radon și mediu</h3>
            <p>Măsurăm concentrația de radon împreunp cu laborator desemnat CNCAN și executăm soluțiile de remediere.</p>
            <span class="link">Despre radon</span>
          </div>
        </a>
        <a class="tile" href="/consultanta/">
          <img src="/images/consultanta.jpg" alt="" width="1536" height="1024" loading="lazy">
          <div class="body">
            <span class="num">04</span>
            <h3>Consultanță și finanțări</h3>
            <p>Identificăm programul potrivit, pregătim dosarul și vă însoțim în implementare.</p>
            <span class="link">Vezi programele</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section mist">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <h2>De ce GMC Proiect Construct</h2>
          <p class="intro">Suntem constructori din 2005. Am adăugat energia, radonul și consultanța pentru că o clădire bună are nevoie de toate patru, iar clientul are nevoie de un singur interlocutor.</p>
        </div>
      </div>
      <div class="cols-4 reveal">
        <div class="panel"><h3>Un singur interlocutor</h3><p>Proiect, execuție, energie, radon și finanțare se discută la aceeași masă. Nu trebuie să coordonați dumneavoastră cinci firme.</p></div>
        <div class="panel"><h3>Execuție coordonată</h3><p>Lucrăm cu echipa proprie și cu parteneri autorizați, în funcție de lucrare, sub coordonarea GMC și cu un singur contract.</p></div>
        <div class="panel"><h3>Clădiri eficiente și sănătoase</h3><p>Eficiența energetică și calitatea aerului interior se proiectează împreună. Suntem membri ARaR, asociația profesioniștilor în radon.</p></div>
        <div class="panel"><h3>Finanțarea face parte din plan</h3><p>Verificăm de la început ce program de finanțare se potrivește proiectului, ca să nu descoperiți prea târziu că erați eligibil.</p></div>
      </div>
    </div>
  </section>

  <section class="section navy">
    <div class="wrap cols-2 reveal">
      <div>
        <h2>Specializarea noastră: radonul</h2>
        <p>Radonul este un gaz radioactiv natural care se acumulează în clădiri, mai ales în cele bine izolate, și este a doua cauză a cancerului pulmonar după fumat. Pentru locurile de muncă de la subsol și parter și pentru clădirile publice, măsurarea este obligatorie prin lege.</p>
        <p>Măsurăm cu detectori pasivi analizați de un laborator desemnat de CNCAN, punem diagnosticul clădirii, executăm remedierea și verificăm rezultatul – în toate județele din România.</p>
        <div class="cta-row" style="margin-top:22px">
          <a class="btn primary" href="/radon/">Măsurare și remediere radon</a>
          <a class="btn outline-light" href="/radon/locul-de-munca/">Obligațiile angajatorului</a>
        </div>
      </div>
      <img class="img-r" src="/images/sectiune.jpg" alt="Radonul pătrunde din sol în clădire" width="1400" height="788" loading="lazy">
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <h2>Cum lucrăm</h2>
          <p class="intro">Același traseu, indiferent de domeniu.</p>
        </div>
      </div>
      <div class="process reveal">
        <div><h3>Discuție și evaluare</h3><p>Venim la dumneavoastră, înțelegem clădirea și obiectivul, și spunem sincer ce are sens și ce nu.</p></div>
        <div><h3>Ofertă scrisă</h3><p>Primiți soluția propusă, etapele, costul și, unde e cazul, programul de finanțare potrivit – înainte de orice angajament.</p></div>
        <div><h3>Execuție coordonată</h3><p>Echipa noastră sau partenerii autorizați execută lucrarea; GMC răspunde de calitate, termene și comunicare.</p></div>
        <div><h3>Recepție și verificare</h3><p>Predăm lucrarea cu documentele ei: proces-verbal, certificate, buletine de măsurare, garanții.</p></div>
      </div>
    </div>
  </section>

  {noutati.length > 0 && (
    <section class="section mist">
      <div class="wrap">
        <div class="section-head reveal">
          <div>
            <h2>Noutăți</h2>
            <p class="intro">Articole de informare și noutăți de la noi.</p>
          </div>
          <a class="btn outline" href="/noutati/">Toate noutățile</a>
        </div>
        <div class="posts reveal">
          {noutati.map((p) => (
            <article class="post">
              <a class="post-img" href={`/noutati/${p.id}/`} tabindex="-1" aria-hidden="true"><img src={p.data.image ?? '/images/sectiune.jpg'} alt="" width="1400" height="788" loading="lazy"></a>
              <div class="body">
                <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                <h3><a href={`/noutati/${p.id}/`}>{p.data.title}</a></h3>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="closing">
    <div class="wrap reveal">
      <h2>Aveți un proiect? Hai să vorbim.</h2>
      <p>
      </p>
      <div class="cta-row">
        <a class="btn primary" href="/contact/">Solicită o ofertă</a>
      </div>
    </div>
  </section>
</Base>
