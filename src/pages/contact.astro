---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
---
<Base title="Contact – solicită o ofertă" description="Contactați GMC Proiect Construct pentru construcții, energie verde, radon sau finanțări: telefon, e-mail sau formular. Vă răspundem cu o ofertă scrisă, în toată România." current="/contact/">

  <section class="page-hero" style="background-image:url('/images/sectiune.jpg')">
    <div class="wrap">
      <div class="breadcrumb"><a href="/">Acasă</a> › Contact</div>
      <h1>Să vorbim despre proiectul dumneavoastră</h1>
      <p class="lead">Spuneți-ne ce aveți de făcut – o casă, un sistem fotovoltaic, o măsurare de radon, un dosar de finanțare – și în ce județ. Vă contactăm, stabilim împreună ce este de făcut și vă trimitem oferta scrisă.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap cols-2" style="align-items:start">
      <div>
        <h2>Cerere de ofertă</h2>
        <p class="muted">Durează un minut. Nu cerem date pe care nu le folosim.</p>
        <ContactForm />
      </div>
      <div>
        <div class="panel" style="margin-bottom:16px">
          <h3>Direct</h3>
          <p style="margin-bottom:8px"><a href="tel:+40722522514" style="font-weight:700">+40 722 522 514</a></p>
          <p><a href="mailto:office@gmc-proiect-construct.ro">office@gmc-proiect-construct.ro</a></p>
        </div>
        <div class="panel" style="margin-bottom:16px">
          <h3>Program</h3>
          <p>Luni – Vineri, 9:00 – 18:00<br>Evaluările la fața locului se programează și în afara programului, la cerere.</p>
        </div>
        <div class="panel">
          <h3>Acoperire</h3>
          <p>Lucrăm în toate județele din România. Pentru firme cu mai multe sedii planificăm lucrările în aceeași perioadă, cu un singur raport.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
