---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = (d: Date) => d.toLocaleDateString('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Blog – despre radon și clădiri sănătoase" description="Articole scurte despre radon, măsurare, remediere și clădiri eficiente energetic, scrise de echipa GMC Proiect Construct." current="/blog/">
  <section class="page-hero" style="background-image:url('/images/sectiune.jpg')">
    <div class="wrap">
      <div class="breadcrumb"><a href="/">Acasă</a> › Blog</div>
      <h1>Blog</h1>
      <p class="lead">Răspunsuri la întrebările pe care ni le pun clienții, pe înțelesul tuturor.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="posts">
        {posts.map((p) => (
          <article class="post">
            <img src={p.data.image ?? '/images/sectiune.jpg'} alt="" width="1400" height="788" loading="lazy">
            <div class="body">
            <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
            <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
            <p>{p.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
