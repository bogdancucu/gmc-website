    <div class="wrap" style="max-width:720px;text-align:center;padding-top:40px;padding-bottom:40px">
      <h1>Mulțumim!</h1>
      <p class="lead" style="margin:0 auto 24px">Vă contactăm în curând pentru a stabili data evaluării.</p>
      <div class="cta-row" style="justify-content:center">
        <a class="btn outline" href="/">Înapoi la prima pagină</a>
      </div>
    </div>
  </section>
</Base>
