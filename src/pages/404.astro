---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina nu există" description="Pagina căutată nu există.">
  <section class="section mist">
    <div class="wrap" style="max-width:720px;text-align:center;padding-top:40px;padding-bottom:40px">
      <h1>Pagina asta nu se vede.</h1>
      <p class="lead" style="margin:0 auto 24px">Spre deosebire de radon, nici nu se măsoară – pur și simplu nu există. Încercați din meniul de sus.</p>
      <a class="btn primary" href="/">Prima pagină</a>
    </div>
  </section>
</Base>
