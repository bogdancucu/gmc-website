---
const { current = '' } = Astro.props;
const links = [
  { href: '/constructii/', label: 'Construcții' },
  { href: '/energie/', label: 'Energie verde' },
  { href: '/radon/', label: 'Radon' },
  { href: '/consultanta/', label: 'Consultanță' },
  { href: '/despre/', label: 'Despre' },
  { href: '/noutati/', label: 'Noutăți' },
];
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="GMC Proiect Construct – prima pagină">
      <img src="/images/logo-gmc.png" alt="GMC Proiect Construct" width="800" height="366">
    </a>
    <button class="nav-toggle" aria-label="Meniu" aria-expanded="false" aria-controls="nav">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav" id="nav" aria-label="Meniu principal">
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.href || (l.href === '/radon/' && ['/masurare-radon/','/remediere-radon/','/radon-la-locul-de-munca/','/cladiri-noi-si-proiectare/','/legislatie/'].includes(current)) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="btn primary" href="/contact/" aria-current={current === '/contact/' ? 'page' : undefined}>Contact</a>
    </nav>
  </div>
</header>
<div class="mobile-cta">
  <a class="call" href="tel:+40722522514">Sună acum</a>
  <a class="wa" href="https://wa.me/40722522514" target="_blank" rel="noopener">WhatsApp</a>
</div>
<script>
  const btn = document.querySelector('.nav-toggle');
  const nav = document.getElementById('nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
