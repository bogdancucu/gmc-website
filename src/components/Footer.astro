---
<footer class="site-footer">
  <div class="wrap">
    <div class="row">
      <div class="brand">
        <img src="/images/logo-gmc.png" alt="GMC Proiect Construct" width="170" height="78" style="width:170px">
        <div class="social">
          {social.map((s) => (
            <a href={s.href} aria-label={s.name} title={s.name} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.icon}></path></svg>
            </a>
          ))}
        </div>
      </div>
      <div class="contact">
        <a class="big" href="tel:+40722522514">+40 722 522 514</a>
        <a href="mailto:radon@gmc-proiect-construct.ro">radon@gmc-proiect-construct.ro</a>
        <span>Luni – vineri, 9:00 – 18:00</span>
      </div>
    </div>
    <div class="legal">
      {firma.nume} · {firma.cui} · {firma.regCom} · {firma.sediu}
    </div>
    <div class="bottom">
      <span>© {year} {firma.nume}</span>
      <span><a href="/confidentialitate/">Politica de confidențialitate</a> · <a href="https://anpc.ro" target="_blank" rel="noopener">ANPC</a></span>
    </div>
